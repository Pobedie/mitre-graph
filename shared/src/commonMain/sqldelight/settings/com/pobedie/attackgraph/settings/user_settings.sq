CREATE TABLE user_settings (
    id INTEGER PRIMARY KEY NOT NULL DEFAULT 0,
    dm_url TEXT NOT NULL,
    dm_api_key TEXT NOT NULL,
    dm_model TEXT NOT NULL,
    dm_confidence_threshold REAL NOT NULL DEFAULT 0.5,
    CONSTRAINT one_row CHECK (id = 0)
);

saveUserSettings:
INSERT OR REPLACE INTO user_settings(id, dm_url, dm_api_key, dm_model, dm_confidence_threshold)
VALUES (0, ?, ?, ?, ?);

getUserSettings:
SELECT dm_url, dm_api_key, dm_model, dm_confidence_threshold
FROM user_settings
WHERE id = 0;
